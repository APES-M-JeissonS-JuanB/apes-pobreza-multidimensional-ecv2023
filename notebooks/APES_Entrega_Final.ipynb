    "# 8.8 VERIFICACIÓN DE LOS CÁLCULOS\n",
    "# Qué hace: compara los márgenes de error de nuestra función contra los de la librería statsmodels en un caso donde ambas deben coincidir.\n",
    "# Resultado esperado: razones muy cercanas a 1.\n",
    "f_test = \"POBRE_IPM ~ C(CLASE) + C(SEXO_JEFE) + EDAD_JEFE + TAM_HOGAR\"\n",
    "T = D.copy(); T[\"UNO\"] = 1\n",
    "mio = svy_glm(f_test, T, estrato=\"UNO\")\n",
    "y_, X_ = dmatrices(f_test, T, return_type=\"dataframe\")\n",
    "wn = T.loc[y_.index, \"FEX_C\"].values; wn = wn / wn.mean()\n",
    "sm_cl = sm.GLM(y_.values.ravel(), X_.values, family=sm.families.Binomial(), freq_weights=wn).fit(\n",
    "    cov_type=\"cluster\", cov_kwds={\"groups\": pd.factorize(T.loc[y_.index, \"PSU\"])[0], \"use_correction\": False})\n",
    "G = mio.n_upm\n",
    "chk = pd.DataFrame({\"SE svy_glm\": mio.se.values, \"SE statsmodels (cluster)\": sm_cl.bse,\n",
    "                    \"razón (esperada, casi 1)\": mio.se.values / sm_cl.bse}, index=mio.beta.index)\n",
    "print(f\"Con {G:,} zonas de muestreo la razón esperada es {np.sqrt(G/(G-1)):.5f}\")\n",
    "display(chk)\n",
    "print(\"\\nNota: la librería samplics todavía no incluye regresión logística, por eso la comparación se hace con statsmodels.\")"
   ],
