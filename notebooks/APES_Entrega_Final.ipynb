    "# Variable respuesta: POBRE_IPM (1 = hogar pobre según el IPM reconstruido).\n",
    "t0 = time.time()\n",
    "M1 = svy_glm(\"POBRE_IPM ~ \" + BASE, D)\n",
    "M2 = svy_glm(\"POBRE_IPM ~ \" + BASE + ING, D)\n",
    "M1n = svy_glm(\"POBRE_IPM ~ \" + BASE, D, diseno=False)\n",
    "M2n = svy_glm(\"POBRE_IPM ~ \" + BASE + ING, D, diseno=False)\n",
    "print(f\"Modelos ajustados en {time.time()-t0:.0f} segundos con {M2.nobs:,} hogares, {M2.n_upm:,} zonas de muestreo y {M2.n_est} grupos de muestreo.\")\n",
    "\n",
    "def tabla_coef(res, ingenuo):\n",
    "    t = stats.t.ppf(.975, res.df)\n",
    "    out = pd.DataFrame({\"OR\": np.exp(res.beta), \"OR_IC95_inf\": np.exp(res.beta - t * res.se), \"OR_IC95_sup\": np.exp(res.beta + t * res.se),\n",
    "                        \"p\": 2 * stats.t.sf(np.abs(res.beta / res.se), res.df),\n",
    "                        \"SE_diseño\": res.se, \"SE_ingenuo\": ingenuo.se, \"DEFT\": res.se / ingenuo.se})\n",
    "    out.index = [limpiar(n) for n in out.index]\n",
    "    return out\n",
    "OR1, OR2 = tabla_coef(M1, M1n), tabla_coef(M2, M2n)\n",
    "print(f\"Al considerar las zonas de muestreo, los márgenes de error son en promedio {OR2['DEFT'].median():.2f} veces los que saldrían tratando los hogares como independientes (el máximo es {OR2['DEFT'].max():.2f} veces).\")\n",
    "\n",
    "# Desempeño: AUC ponderado (1 es perfecto, 0,5 es como lanzar una moneda). Sirve para comparar M1 con M2.\n",
    "AUC1 = roc_auc_score(M1.y, M1.mu, sample_weight=M1.w); AUC2 = roc_auc_score(M2.y, M2.mu, sample_weight=M2.w)\n",
    "print(f\"\\nQué tan bien separa a los hogares pobres (AUC): sin ingreso {AUC1:.3f}, con ingreso {AUC2:.3f}, diferencia {AUC2-AUC1:+.3f}\")\n",
    "wi = [n for n in M2.beta.index if \"Q_ING\" in n]\n",
