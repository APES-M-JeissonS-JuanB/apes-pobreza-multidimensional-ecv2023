    "# 8.6 COMPARACIÓN ENTRE DEPARTAMENTOS\n",
    "# Qué hace: ajusta el modelo dándole a cada departamento su propio nivel de pobreza, primero sin región y luego con región.\n",
    "# Cómo leer: la variación entre departamentos mide cuánto se parecen o se diferencian los departamentos; el porcentaje indica qué parte de la diferencia entre hogares se debe al departamento.\n",
    "from statsmodels.genmod.bayes_mixed_glm import BinomialBayesMixedGLM\n",
=======
    "# 9.6 MODELO MULTINIVEL (intercepto aleatorio por departamento)\n",
    "# Qué hace: ajusta (a) M2 sin región + intercepto por departamento y (b) M2 con región + intercepto por departamento.\n",
    "# Cómo: máxima verosimilitud con la aproximación de Laplace (como glmer en R), con gradiente exacto. Se reemplazó el\n",
    "#       ajuste variacional (BinomialBayesMixedGLM.fit_vb) porque daba resultados distintos en cada ejecución.\n",
    "# Cómo leer: sigma = desviación estándar entre departamentos (escala logit); ICC = sigma² / (sigma² + pi²/3).\n",
    "# GLMM logit con intercepto aleatorio por grupo, ajustado por máxima verosimilitud con la aproximación de Laplace\n",
    "# (el mismo método que usa por defecto glmer en R). Es determinístico: siempre da el mismo resultado.\n",
    "from scipy.optimize import minimize\n",
    "from scipy.special import expit\n",
    "def glmm_laplace(y, X, grupos, iters_newton=60):\n",
    "    \"\"\"logit(p_ij) = X_ij·beta + b_j, con b_j ~ N(0, sigma²). Devuelve beta, sigma, IC 95% de sigma y log-verosimilitud.\"\"\"\n",
    "    y = np.asarray(y, float); X = np.asarray(X, float)\n",
    "    g = pd.factorize(grupos)[0]; J = g.max() + 1\n",
    "    def modos(eta, s2, b):\n",
    "        for _ in range(iters_newton):                       # Newton por grupo para el modo de b_j\n",
    "            p = expit(eta + b[g])\n",
    "            paso = np.clip((np.bincount(g, y - p, J) - b / s2) / (np.bincount(g, p * (1 - p), J) + 1 / s2), -1, 1)\n",
    "            b = b + paso\n",
    "            if np.abs(paso).max() < 1e-10: break\n",
    "        return b\n",
    "    cache = {\"b\": np.zeros(J)}\n",
    "    def obj(theta):\n",
    "        beta, ls = theta[:-1], theta[-1]; s2 = np.exp(2 * ls)\n",
    "        eta = X @ beta\n",
    "        b = modos(eta, s2, cache[\"b\"].copy()); cache[\"b\"] = b\n",
    "        lin = eta + b[g]; p = expit(lin); w1 = p * (1 - p)\n",
    "        H = np.bincount(g, w1, J) + 1 / s2\n",
    "        ll = np.sum(y * lin - np.logaddexp(0, lin)) - np.sum(b**2) / (2 * s2) - J * ls - 0.5 * np.sum(np.log(H))\n",
    "        # Gradiente exacto (teorema de la envolvente + derivada de log H a través de beta y del modo b_j)\n",
    "        w2 = w1 * (1 - 2 * p)\n",
    "        Dx = np.vstack([np.bincount(g, w1 * X[:, k], J) for k in range(X.shape[1])]).T     # J x k\n",
    "        Ax = np.vstack([np.bincount(g, w2 * X[:, k], J) for k in range(X.shape[1])]).T\n",
    "        c = np.bincount(g, w2, J)\n",
    "        dH = Ax - (c / H)[:, None] * Dx\n",
    "        gbeta = X.T @ (y - p) - 0.5 * (dH / H[:, None]).sum(0)\n",
    "        # derivada respecto a log sigma (por envolvente en b; H depende de s2 y de b)\n",
    "        db = b / (s2**2 * H)                                    # d b_j / d sigma²\n",
    "        dH_ds2 = -1 / s2**2 + c * db\n",
    "        gls = (np.sum(b**2) / (2 * s2**2) - J / (2 * s2) - 0.5 * np.sum(dH_ds2 / H)) * 2 * s2\n",
    "        return -ll, -np.r_[gbeta, gls]\n",
    "    beta0 = sm.GLM(y, X, family=sm.families.Binomial()).fit().params\n",
