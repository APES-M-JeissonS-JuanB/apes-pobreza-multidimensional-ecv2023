    "# 9.8 ROBUSTEZ: ¿EL ESTRATO ES UNA VARIABLE REALMENTE EXTERNA AL IPM?\n",
    "# Qué hace: (a) compara a los hogares sin estrato con los demás en los indicadores de servicios del IPM;\n",
    "#           (b) reajusta M2 sin esos hogares y sin la variable de estrato, y compara los efectos marginales.\n",
    "# Por qué: el estrato se asigna en la factura de energía. Un hogar sin estrato casi siempre carece de servicios\n",
    "#          públicos, y eso ya lo miden I11 (agua) e I12 (excretas). Si es así, ese efecto es en parte mecánico.\n",
    "sin = D[\"ESTRATO_CAT\"] == \"Sin estrato\"\n",
    "def pct(m, c):\n",
    "    return 100 * np.average(c[m] if isinstance(c, pd.Series) else D.loc[m, c], weights=D.loc[m, \"FEX_C\"])\n",
    "filas_perfil = {\"I11 sin fuente de agua mejorada\": \"I11_agua\", \"I12 eliminación de excretas inadecuada\": \"I12_excretas\",\n",
    "                \"I13 piso de tierra\": \"I13_pisos\", \"Pobre multidimensional (POBRE_IPM)\": \"POBRE_IPM\"}\n",
    "perfil = pd.DataFrame({\"Sin estrato (%)\": [pct(sin, c) for c in filas_perfil.values()],\n",
    "                       \"Con estrato 1-6 (%)\": [pct(~sin, c) for c in filas_perfil.values()]}, index=list(filas_perfil))\n",
    "rural = (D[\"CLASE\"] != 1).astype(int)\n",
    "perfil.loc[\"Zona rural\"] = [pct(sin, rural), pct(~sin, rural)]\n",
    "print(f\"Hogares sin estrato: {sin.sum():,} ({100*np.average(sin, weights=D['FEX_C']):.1f}% ponderado)\")\n",
    "display(perfil.round(1))\n",
    "\n",
    "# (b) Dos reajustes de M2: (i) solo hogares con estrato 1-6; (ii) toda la muestra pero sin la variable de estrato.\n",
    "BASE_NOEST = BASE.replace(\" + C(ESTRATO_CAT, Treatment(reference='1'))\", \"\")\n",
    "D_con = D[~sin].copy()\n",
    "M2_con   = svy_glm(\"POBRE_IPM ~ \" + BASE + ING, D_con)\n",
    "M2_noest = svy_glm(\"POBRE_IPM ~ \" + BASE_NOEST + ING, D)\n",
    "A2_con   = tabla_ame(M2_con, D_con, con_ingreso=True)\n",
    "A2_noest = tabla_ame(M2_noest, D, con_ingreso=True)\n",
    "A2_noest = A2_noest[~A2_noest.index.str.startswith(\"Estrato\")]      # el estrato no está en este modelo\n",
    "rob = (A2[[\"pp\"]].rename(columns={\"pp\": \"M2 (completo)\"})\n",
    "       .join(A2_con[[\"pp\"]].rename(columns={\"pp\": \"M2 sin hogares 'Sin estrato'\"}))\n",
    "       .join(A2_noest[[\"pp\"]].rename(columns={\"pp\": \"M2 sin variable estrato\"})))\n",
    "auc = lambda r: roc_auc_score(r.y, r.mu, sample_weight=r.w)\n",
    "print(f\"AUC ponderado | M2: {AUC2:.3f} | sin hogares 'Sin estrato': {auc(M2_con):.3f} | sin variable estrato: {auc(M2_noest):.3f}\")\n",
    "print(\"Efectos marginales promedio (pp) en las tres versiones de M2:\")\n",
    "display(rob.round(2))\n",
    "rob.to_csv(os.path.join(TABLAS, \"09_robustez_estrato.csv\")); perfil.to_csv(os.path.join(TABLAS, \"09_perfil_sin_estrato.csv\"))"
   ]
