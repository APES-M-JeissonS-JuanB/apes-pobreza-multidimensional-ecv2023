    "        if e in set(data[\"ESTRATO_CAT\"]): E.append(dict(label=f\"Estrato {e} vs. estrato 1\", col=\"ESTRATO_CAT\", base=\"1\", nuevo=e))\n",
    "    if con_ingreso:\n",
    "        for q in sorted(set(data[\"Q_ING\"]) - {\"Q1\"}):\n",
    "            E.append(dict(label=f\"Ingreso per cápita {q} vs. Q1\", col=\"Q_ING\", base=\"Q1\", nuevo=q))\n",
    "    return E\n",
    "\n",
    "def tabla_ame(res, data, con_ingreso, **kw):\n",
    "    filas = []\n",
    "    for e in lista_efectos(data, con_ingreso):\n",
    "        r = ame(res, data, e[\"col\"], nuevo=e.get(\"nuevo\"), base=e.get(\"base\"), delta=e.get(\"delta\"), **kw)\n",
