    "\n",
    "# Estrato socioeconómico como categoría; los hogares sin estrato (no tienen factura de servicios) se conservan como \"Sin estrato\".\n",
    "d[\"ESTRATO_CAT\"] = d[\"ESTRATO\"].map(lambda v: \"Sin estrato\" if pd.isna(v) else str(int(v)))\n",
    "\n",
    "# Ingreso per cápita en quintiles ponderados (los hogares con ingreso 0 caen en Q1; sin dato = \"Sin dato\").\n",
    "def cuantiles_pond(x, w, qs):\n",
    "    o = np.argsort(x); x, w = np.asarray(x)[o], np.asarray(w)[o]\n",
    "    c = np.cumsum(w) / w.sum()\n",
    "    return [x[np.searchsorted(c, q)] for q in qs]\n",
    "ok = d[\"PERCAPITA\"].notna()\n",
    "cortes = cuantiles_pond(d.loc[ok, \"PERCAPITA\"].values, d.loc[ok, \"FEX_C\"].values, [.2, .4, .6, .8])\n",
    "d[\"Q_ING\"] = \"Sin dato\"\n",
    "d.loc[ok, \"Q_ING\"] = [\"Q\" + str(1 + sum(v > c for c in cortes)) for v in d.loc[ok, \"PERCAPITA\"]]\n",
    "print(\"Cortes de quintiles de ingreso per cápita:\", [round(c) for c in cortes])\n",
    "print(d[\"Q_ING\"].value_counts().sort_index().to_string())\n",
    "print(\"Hogares sin estrato:\", (d[\"ESTRATO_CAT\"] == \"Sin estrato\").sum(), \"| CLASE:\", d[\"CLASE\"].value_counts().to_dict())\n",
    "\n",
    "# Interacción zona x región: una variable \"rural en la región r\" solo para regiones que tienen hogares urbanos Y rurales.\n",
    "tab = pd.crosstab(d[\"REGION\"], d[\"CLASE\"])\n",
    "REGS_OK = [r for r in tab.index if tab.loc[r].get(1, 0) >= 30 and tab.loc[r, [c for c in tab.columns if c != 1]].sum() >= 30]\n",
    "REF_INT = REF_REGION if REF_REGION in REGS_OK else REGS_OK[0]\n",
    "REGS_INT = [r for r in REGS_OK if r != REF_INT]\n",
    "print(\"Regiones con hogares urbanos y rurales (para la interacción):\", [REGIONES[r] for r in REGS_OK])\n",
    "def construir(df):\n",
    "    \"\"\"Agrega las variables de interacción rural x región (se recalculan cuando se cambia CLASE o REGION).\"\"\"\n",
    "    df = df.copy()\n",
    "    for r in REGS_INT:\n",
    "        df[f\"RxR{r}\"] = ((df[\"CLASE\"] != 1) & (df[\"REGION\"] == r)).astype(int)\n",
    "    return df\n",
    "D = construir(d)\n",
    "\n",
    "BASE = \"C(CLASE) + C(REGION, Treatment(reference=%d)) + C(SEXO_JEFE) + EDAD_JEFE + TAM_HOGAR + C(ESTRATO_CAT, Treatment(reference='1'))\" % REF_REGION\n",
    "ING  = \" + C(Q_ING, Treatment(reference='Q1'))\"\n",
    "\n",
    "# (b) GLM con varianza de diseño\n",
    "def svy_glm(formula, data, family=None, w=\"FEX_C\", estrato=\"ESTRATO2020\", upm=\"PSU\", diseno=True):\n",
    "    \"\"\"GLM ponderado (pesos normalizados) con covarianza sándwich de Taylor por estrato y UPM.\n",
    "    diseno=False trata cada hogar como independiente (solo para comparar: error estándar 'ingenuo').\"\"\"\n",
    "    family = family or sm.families.Binomial()\n",
    "    y, X = dmatrices(formula, data, return_type=\"dataframe\")\n",
    "    sub = data.loc[y.index]\n",
    "    wt = sub[w].values.astype(float); wt = wt / wt.mean()\n",
    "    yy = y.values.ravel(); XX = X.values\n",
    "    fit = sm.GLM(yy, XX, family=family, freq_weights=wt).fit()\n",
    "    mu = fit.mu\n",
    "    A = (XX * (wt * mu * (1 - mu))[:, None]).T @ XX            # \"pan\" del sándwich\n",
    "    U = XX * (wt * (yy - mu))[:, None]                           # contribución de cada hogar al score\n",
    "    if diseno: s, p = sub[estrato].values, sub[upm].values\n",
    "    else:      s, p = np.zeros(len(sub), dtype=int), np.arange(len(sub))\n",
    "    Z = pd.DataFrame(U).groupby([s, p]).sum()                    # totales por UPM\n",
    "    meat = np.zeros((XX.shape[1],) * 2); solitarias = 0\n",
    "    for _, g in Z.groupby(level=0):\n",
    "        n = len(g)\n",
    "        if n < 2: solitarias += 1; continue                      # estrato con una UPM: aporta 0 (\"certeza\")\n",
    "        zc = g.values - g.values.mean(0)\n",
    "        meat += n / (n - 1) * zc.T @ zc\n",
    "    Ai = np.linalg.inv(A); cov = Ai @ meat @ Ai\n",
    "    n_upm_, n_est_ = Z.shape[0], Z.index.get_level_values(0).nunique()\n",
    "    gl = (n_upm_ - n_est_) if diseno else (len(yy) - XX.shape[1])\n",
    "    nombres = list(X.columns)\n",
    "    return SimpleNamespace(beta=pd.Series(fit.params, nombres), cov=pd.DataFrame(cov, nombres, nombres),\n",
    "                           se=pd.Series(np.sqrt(np.diag(cov)), nombres), df=gl, nobs=len(yy), rows=y.index,\n",
    "                           design_info=X.design_info, mu=mu, y=yy, w=wt, n_upm=n_upm_, n_est=n_est_, solitarias=solitarias)\n",
    "\n",
    "# (c) Efectos marginales promedio (AME) en puntos porcentuales, con método delta\n",
    "def ame(res, data, col, nuevo=None, base=None, delta=None, mask=None):\n",
    "    \"\"\"Cambio promedio en la probabilidad (pp) si se pasa de 'base' a 'nuevo' en 'col' (o se suma 'delta'),\n",
    "    manteniendo todo lo demás como está en cada hogar. Error estándar por método delta con la covarianza de diseño.\"\"\"\n",
    "    x = data.loc[res.rows]\n",
    "    if mask is not None: x = x[mask(x)]\n",
    "    x0, x1 = x.copy(), x.copy()\n",
    "    if delta is not None: x1[col] = x1[col] + delta\n",
    "    else:\n",
    "        if base is not None: x0[col] = base\n",
    "        x1[col] = nuevo\n",
    "    X0 = build_design_matrices([res.design_info], construir(x0), return_type=\"dataframe\")[0].values\n",
    "    X1 = build_design_matrices([res.design_info], construir(x1), return_type=\"dataframe\")[0].values\n",
    "    b = res.beta.values\n",
    "    p0, p1 = 1 / (1 + np.exp(-X0 @ b)), 1 / (1 + np.exp(-X1 @ b))\n",
    "    wt = x[\"FEX_C\"].values; sw = wt.sum()\n",
    "    g = np.sum(wt * (p1 - p0)) / sw\n",
    "    grad = ((wt * p1 * (1 - p1))[:, None] * X1 - (wt * p0 * (1 - p0))[:, None] * X0).sum(0) / sw\n",
    "    se = float(np.sqrt(grad @ res.cov.values @ grad)); t = stats.t.ppf(.975, res.df)\n",
    "    return dict(pp=100 * g, se=100 * se, lo=100 * (g - t * se), hi=100 * (g + t * se), p=2 * stats.t.sf(abs(g / se), res.df))\n",
    "\n",
    "def wald(res, nombres):\n",
    "    \"\"\"Prueba conjunta de que varios coeficientes son 0 (F de Wald ajustada por diseño).\"\"\"\n",
    "    i = [res.beta.index.get_loc(n) for n in nombres]; b = res.beta.values[i]; V = res.cov.values[np.ix_(i, i)]\n",
    "    k = len(i); W = float(b @ np.linalg.solve(V, b)); F = W * (res.df - k + 1) / (res.df * k)\n",
    "    return dict(k=k, F=F, p=stats.f.sf(F, k, res.df - k + 1))\n",
    "\n",
    "def lista_efectos(data, con_ingreso):\n",
    "    E = [dict(label=\"Zona: rural vs. urbano\", col=\"CLASE\", base=1, nuevo=2)]\n",
    "    for r in sorted(data[\"REGION\"].unique()):\n",
    "        if r != REF_REGION: E.append(dict(label=f\"Región {REGIONES[r]} vs. {REGIONES[REF_REGION]}\", col=\"REGION\", base=REF_REGION, nuevo=r))\n",
    "    E += [dict(label=\"Jefe mujer vs. hombre\", col=\"SEXO_JEFE\", base=1, nuevo=2),\n",
