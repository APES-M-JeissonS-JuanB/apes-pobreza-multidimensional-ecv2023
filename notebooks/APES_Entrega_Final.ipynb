    "# 8.4 CAMBIO EN LA PROBABILIDAD DE SER POBRE (PUNTOS PORCENTUALES)\n",
    "# Qué hace: calcula cuánto cambia, en puntos porcentuales, la probabilidad de ser pobre al cambiar cada característica; compara M1 con M2 y lo grafica.\n",
    "t0 = time.time()\n",
    "A1 = tabla_ame(M1, D, con_ingreso=False)\n",
    "A2 = tabla_ame(M2, D, con_ingreso=True)\n",
    "print(f\"Cálculo hecho en {time.time()-t0:.0f} segundos\")\n",
    "comp = A1[[\"pp\", \"lo\", \"hi\"]].join(A2[[\"pp\", \"lo\", \"hi\"]], how=\"outer\", lsuffix=\"_M1\", rsuffix=\"_M2\")\n",
    "comp[\"cambio_pp\"] = comp[\"pp_M2\"] - comp[\"pp_M1\"]\n",
    "comp[\"cambio_%\"] = 100 * comp[\"cambio_pp\"] / comp[\"pp_M1\"].abs()\n",
    "print(\"Cambio en la probabilidad de ser pobre, en puntos porcentuales (con su intervalo de confianza del 95%). Las columnas _M1 son sin ingreso y las _M2 con ingreso:\")\n",
    "display(comp.round(2))\n",
    "A1.to_csv(os.path.join(TABLAS, \"09_M1_AME_pp.csv\")); A2.to_csv(os.path.join(TABLAS, \"09_M2_AME_pp.csv\")); comp.to_csv(os.path.join(TABLAS, \"09_comparacion_M1_M2.csv\"))\n",
    "\n",
    "# Gráfico de bosque: M1 (sin ingreso) vs M2 (con ingreso)\n",
    "sin_ing = [i for i in comp.index if \"Ingreso\" not in i]\n",
    "fig, ax = plt.subplots(figsize=(9, 0.38 * len(comp) + 1.5))\n",
    "y = np.arange(len(comp))[::-1]\n",
    "for k, (suf, c, m, off) in enumerate([(\"M1\", \"#4C72B0\", \"o\", .13), (\"M2\", \"#DD8452\", \"s\", -.13)]):\n",
    "    sub = comp[[f\"pp_{suf}\", f\"lo_{suf}\", f\"hi_{suf}\"]]; mk = sub.notna().all(axis=1).values\n",
    "    ax.errorbar(sub[f\"pp_{suf}\"][mk], y[mk] + off, xerr=[(sub[f\"pp_{suf}\"] - sub[f\"lo_{suf}\"])[mk], (sub[f\"hi_{suf}\"] - sub[f\"pp_{suf}\"])[mk]],\n",
    "                fmt=m, color=c, capsize=2, label=\"Sin ingreso (M1)\" if suf == \"M1\" else \"Con ingreso (M2)\")\n",
    "ax.axvline(0, color=\"gray\", lw=1); ax.set_yticks(y); ax.set_yticklabels(comp.index, fontsize=8)\n",
    "ax.set_xlabel(\"Cambio en la probabilidad de ser pobre (puntos porcentuales)\"); ax.set_title(\"Cambio en la probabilidad de ser pobre (intervalo del 95%)\")\n",
    "ax.legend(loc=\"lower right\"); plt.tight_layout()\n",
    "plt.savefig(os.path.join(FIGURES, \"09_efectos_marginales_M1_M2.png\"), dpi=150); plt.show()"
