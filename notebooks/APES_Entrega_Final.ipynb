   "source": [
    "# 9.9 EVALUACIÓN FUERA DE MUESTRA (entrenamiento / prueba por UPM)\n",
    "# Qué hace: separa el 30% de las UPM como prueba, ajusta M1 y M2 solo con el 70% restante y mide en la prueba:\n",
    "#           AUC, Brier, sensibilidad y especificidad (todo ponderado con FEX_C), y la calibración por deciles.\n",
    "# Por qué: el AUC de 9.3 es dentro de muestra. Separar por UPM (y no por hogar) evita que hogares vecinos,\n",
    "#          que se parecen, queden a la vez en entrenamiento y en prueba.\n",
    "from sklearn.metrics import roc_curve\n",
    "rng = np.random.default_rng(42)\n",
    "upms = D[\"PSU\"].unique()\n",
    "upm_prueba = set(rng.choice(upms, size=int(0.3 * len(upms)), replace=False))\n",
    "es_prueba = D[\"PSU\"].isin(upm_prueba)\n",
    "TR, TE = D[~es_prueba], D[es_prueba]\n",
    "print(f\"Entrenamiento: {len(TR):,} hogares ({len(upms) - len(upm_prueba):,} UPM) | Prueba: {len(TE):,} hogares ({len(upm_prueba):,} UPM)\")\n",
    "\n",
    "def evaluar(nombre, formula):\n",
    "    y, X = dmatrices(formula, TR, return_type=\"dataframe\")\n",
    "    wtr = TR.loc[y.index, \"FEX_C\"].values; wtr = wtr / wtr.mean()\n",
    "    fit = sm.GLM(y.values.ravel(), X.values, family=sm.families.Binomial(), freq_weights=wtr).fit()\n",
    "    p_tr = fit.predict(X.values)\n",
    "    Xte = build_design_matrices([X.design_info], TE, return_type=\"dataframe\")[0]\n",
    "    p_te = fit.predict(Xte.values); y_te = TE.loc[Xte.index, \"POBRE_IPM\"].values; w_te = TE.loc[Xte.index, \"FEX_C\"].values\n",
    "    # Umbral elegido en ENTRENAMIENTO (índice de Youden), aplicado sin cambios a la prueba\n",
    "    fpr, tpr, thr = roc_curve(y.values.ravel(), p_tr, sample_weight=wtr)\n",
    "    umbral = thr[np.argmax(tpr - fpr)]\n",
    "    pred = p_te >= umbral\n",
    "    sens = np.average(pred[y_te == 1], weights=w_te[y_te == 1]); esp = np.average(~pred[y_te == 0], weights=w_te[y_te == 0])\n",
    "    prec = np.average(y_te[pred] == 1, weights=w_te[pred])\n",
    "    prev = np.average(y_te, weights=w_te)\n",
    "    brier = np.average((p_te - y_te) ** 2, weights=w_te); brier0 = np.average((prev - y_te) ** 2, weights=w_te)\n",
    "    return dict(modelo=nombre, AUC_prueba=roc_auc_score(y_te, p_te, sample_weight=w_te), Brier=brier,\n",
    "                Brier_ref=brier0, umbral=umbral, sensibilidad=sens, especificidad=esp, precision=prec), (p_te, y_te, w_te)\n",
    "\n",
    "ev_m1, _ = evaluar(\"M1 (sin ingreso)\", \"POBRE_IPM ~ \" + BASE)\n",
    "ev_m2, (p2, y2, w2) = evaluar(\"M2 (con ingreso)\", \"POBRE_IPM ~ \" + BASE + ING)\n",
    "evalua = pd.DataFrame([ev_m1, ev_m2]).set_index(\"modelo\")\n",
    "print(\"Desempeño en la muestra de PRUEBA (ponderado con FEX_C). Brier_ref = Brier de predecir a todos la prevalencia.\")\n",
    "display(evalua.round(3))\n",
    "\n",
    "# Calibración de M2 en la prueba: probabilidad predicha promedio vs. % observado de pobres, por decil de riesgo\n",
    "dec = pd.qcut(p2, 10, labels=False, duplicates=\"drop\")\n",
    "cal = pd.DataFrame({\"dec\": dec, \"p\": p2, \"y\": y2, \"w\": w2}).groupby(\"dec\").apply(\n",
    "    lambda g: pd.Series({\"predicho_%\": 100 * np.average(g.p, weights=g.w), \"observado_%\": 100 * np.average(g.y, weights=g.w)}))\n",
    "display(cal.round(1))\n",
    "fig, ax = plt.subplots(figsize=(5.5, 5))\n",
    "ax.plot([0, cal.values.max() * 1.05], [0, cal.values.max() * 1.05], color=\"gray\", lw=1, ls=\"--\", label=\"Calibración perfecta\")\n",
    "ax.plot(cal[\"predicho_%\"], cal[\"observado_%\"], \"o-\", color=\"#DD8452\", label=\"M2 (deciles de riesgo)\")\n",
    "ax.set_xlabel(\"Probabilidad predicha de ser pobre (%)\"); ax.set_ylabel(\"Hogares pobres observados (%)\")\n",
    "ax.set_title(\"Calibración de M2 en la muestra de prueba\"); ax.legend(); plt.tight_layout()\n",
    "plt.savefig(os.path.join(FIGURES, \"09_calibracion_M2.png\"), dpi=150); plt.show()\n",
    "evalua.to_csv(os.path.join(TABLAS, \"09_evaluacion_prueba.csv\")); cal.to_csv(os.path.join(TABLAS, \"09_calibracion_M2.csv\"))"
   ]
  },
